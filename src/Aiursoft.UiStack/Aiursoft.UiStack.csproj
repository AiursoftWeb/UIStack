<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <Version>10.0.39</Version>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Aiursoft.UiStack</AssemblyName>
    <RootNamespace>Aiursoft.UiStack</RootNamespace>
    <IsTestProject>false</IsTestProject>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <IsPackable>true</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Company>Aiurosft</Company>
    <Product>UiStack</Product>
    <Description>Nuget package of 'UiStack' provided by Aiurosft</Description>
    <PackageId>Aiursoft.UiStack</PackageId>
    <PackageTags>nuget package dotnet csproj dependencies</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/AiursoftWeb/uistack</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/AiursoftWeb/uistack.git</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>
  <Target Name="PrepareFrontendResources" BeforeTargets="AssignTargetPaths" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="npm ci --ignore-scripts --prefix wwwroot" />
    <Error Condition="!Exists('wwwroot/node_modules/@aiursoft/uistack/dist/css/app.css')" Text="The UIStack npm package is missing its compiled assets."></Error>
    <ItemGroup>
      <_FrontendDistFiles Include="wwwroot/node_modules/@aiursoft/uistack/dist/**/*" />
    </ItemGroup>
    <RemoveDir Directories="Resources/dist"></RemoveDir>
    <Copy SourceFiles="@(_FrontendDistFiles)" DestinationFolder="Resources/dist/%(RecursiveDir)"></Copy>
    <ItemGroup>
      <EmbeddedResource Include="Resources/dist/**/*" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <Content Remove="wwwroot/**" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <None Include="../../README.md" Pack="true" PackagePath="." />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Views/Shared/" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Aiursoft.WebTools" Version="10.0.21" />
  </ItemGroup>
</Project>
