<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <Version>10.0.23</Version>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Aiursoft.UiStack</AssemblyName>
    <RootNamespace>Aiursoft.UiStack</RootNamespace>
    <IsTestProject>false</IsTestProject>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <IsPackable>true</IsPackable>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Company>Aiurosft</Company>
    <Product>UiStack</Product>
    <Description>Nuget package of 'UiStack' provided by Aiurosft</Description>
    <PackageId>Aiursoft.UiStack</PackageId>
    <PackageTags>nuget package dotnet csproj dependencies</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://gitlab.aiursoft.com/aiursoft/uistack</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://gitlab.aiursoft.com/aiursoft/uistack.git</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>

  <Target Name="BuildFrontend" BeforeTargets="BeforeBuild"
          Condition="!Exists('Resources/dist/css/app.css')">
    <Exec Command="npm install" WorkingDirectory="../Aiursoft.UiStack.Frontend" />
    <Exec Command="npm run build" WorkingDirectory="../Aiursoft.UiStack.Frontend" />
    <ItemGroup>
      <_FrontendDistFiles Include="../Aiursoft.UiStack.Frontend/dist/**" />
    </ItemGroup>
    <Copy SourceFiles="@(_FrontendDistFiles)" DestinationFolder="Resources/dist/%(RecursiveDir)" />
  </Target>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <None Include="../../README.md" Pack="true" PackagePath="." />
    <EmbeddedResource Include="Resources/dist/**/*" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Views/Shared/" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Aiursoft.WebTools" Version="10.0.13" />
  </ItemGroup>
</Project>