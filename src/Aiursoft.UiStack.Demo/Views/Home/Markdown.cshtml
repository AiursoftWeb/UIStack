@model Aiursoft.UiStack.Demo.Models.ViewModels.HomeViewModels.MarkdownEditorViewModel

<style>
    .markdown-demo-toolbar {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.6rem 1rem;
        background: var(--bs-tertiary-bg);
        border: 1px solid var(--bs-border-color);
        border-bottom: none;
        border-radius: 14px 14px 0 0;
    }
    .markdown-demo-toolbar .btn-group .btn {
        border-radius: 10px;
        padding: 0.35rem 0.9rem;
        font-size: 0.82rem;
    }
    .markdown-demo-editor-wrap {
        border: 1px solid var(--bs-border-color);
        border-radius: 0 0 14px 14px;
        overflow: hidden;
    }
    #markdownEditorContainer {
        min-height: 480px;
    }
    #markdownPreview {
        min-height: 480px;
        padding: 1rem;
        overflow-y: auto;
        background: var(--bs-body-bg);
    }
</style>

<div class="row mb-2">
    <div class="col">
        <h3>Markdown Editor</h3>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div id="editorPane">
            <div class="markdown-demo-toolbar">
                <span class="fw-semibold me-2">View:</span>
                <div class="btn-group btn-group-sm" role="group">
                    <button type="button" class="btn btn-outline-secondary active" id="btnEditorMode">Edit</button>
                    <button type="button" class="btn btn-outline-secondary" id="btnSplitMode">Split</button>
                    <button type="button" class="btn btn-outline-secondary" id="btnPreviewMode">Preview</button>
                </div>
                <span class="ms-auto text-muted small">Ctrl+V paste image | Drag &amp; drop image</span>
            </div>
            <div class="markdown-demo-editor-wrap">
                <div class="row g-0" style="min-height:480px">
                    <div class="col-6" id="editorCol">
                        <div id="markdownEditorContainer" style="height:100%"></div>
                        <textarea id="markdownSource" class="d-none">@Model.InitialMarkdown</textarea>
                    </div>
                    <div class="col-6 border-start" id="previewCol">
                        <div id="markdownPreview"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


@section scripts {
    <script>var require = { paths: { 'vs': '/node_modules/monaco-editor/min/vs' } };</script>
    <script src="~/node_modules/monaco-editor/min/vs/loader.js" asp-append-version="true"></script>
    <script src="~/node_modules/mermaid/dist/mermaid.min.js" asp-append-version="true"></script>
    <script src="~/node_modules/@@aiursoft/uistack-markdown-ui/dist/index.global.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', async function () {
            const editorContainer = document.getElementById('markdownEditorContainer');
            const textarea = document.getElementById('markdownSource');
            const preview = document.getElementById('markdownPreview');
            const editorPane = document.getElementById('editorCol');
            const previewPane = document.getElementById('previewCol');

            try {
                const controller = await AiursoftMarkdownUi.createMarkdownEditor({
                    editorContainer,
                    textarea,
                    previewContainer: preview,
                    editorPane,
                    previewPane,
                    loadMonaco: () => AiursoftMarkdownUi.loadMonacoFromAmd(),
                    uploadUrl: '/files/upload',
                    theme: 'vs',
                    mermaidTheme: 'default',
                    initialViewMode: 'split',
                    viewModeStorageKey: 'demo-markdown-mode',
                    viewModeControls: [
                        { element: document.getElementById('btnEditorMode'), mode: 'editor' },
                        { element: document.getElementById('btnSplitMode'), mode: 'split' },
                        { element: document.getElementById('btnPreviewMode'), mode: 'preview' }
                    ],
                    mermaid: window.mermaid,
                    onSave: markdown => console.log('Saved:', markdown.substring(0, 100) + '...'),
                    onPreviewError: error => console.error('Preview error:', error),
                    onInitializationError: error => console.error('Init error:', error),
                    imageUploadOptions: {
                        onError: (error, file) => console.error('Upload failed for', file.name, error)
                    }
                });

                window.markdownEditor = controller;
            } catch (error) {
                console.error('Failed to create markdown editor:', error);
                textarea.classList.remove('d-none');
                textarea.style.display = '';
                editorContainer.hidden = true;
            }
        });
    </script>
}
